<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet author="crediblex" id="0067-create-product-loan-dpd-repayment-config">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_product_loan_dpd_repayment_config"/>
            </not>
        </preConditions>
        <createTable tableName="m_product_loan_dpd_repayment_config">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="loan_product_id" type="BIGINT">
                <constraints nullable="false" unique="true"/>
            </column>
            <column defaultValueBoolean="false" name="enable_dpd_principal_only" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column defaultValueNumeric="60" name="dpd_threshold" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="m_product_loan_dpd_repayment_config"
                                 baseColumnNames="loan_product_id"
                                 constraintName="fk_dpd_repayment_config_loan_product"
                                 referencedTableName="m_product_loan"
                                 referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>
