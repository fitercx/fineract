<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!--
        Runs against the tenant-store DB, not the tenant DB.

        LMS-184: the tenant timezone drives the business date and the timezone job cron expressions are
        evaluated in. fineract.tenant.timezone only seeds the tenant row, so existing tenants are moved here.
        Ships together with custom-changelog 0075, which keeps every job at its previous UAE run time.
        Deploy outside 00:00-01:30 Asia/Kolkata, otherwise the business date steps back a day.
    -->
    <changeSet author="crediblex" id="lms-184-set-tenant-timezone-uae" context="tenant_store_db">
        <comment>Move tenants from Asia/Kolkata to Asia/Dubai</comment>
        <update tableName="tenants">
            <column name="timezone_id" value="Asia/Dubai"/>
            <where>timezone_id = 'Asia/Kolkata'</where>
        </update>
    </changeSet>

</databaseChangeLog>
