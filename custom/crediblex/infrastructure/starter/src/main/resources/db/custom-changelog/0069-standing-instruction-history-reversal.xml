<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!--
        Adds reversal tracking columns to m_account_transfer_standing_instructions_history.
        - account_transfer_transaction_id: links the execution history row to the actual transfer transaction
          (populated at write-time going forward; legacy rows can be backfilled via ChangeSet 3)
        - is_reversed / reversed_at / reversed_by_user_id: track whether and when an operator reversed
          the standing instruction payment.

        Also seeds the REVERSE_STANDING_INSTRUCTION_HISTORY permission for the new API action.
    -->

    <!-- ChangeSet 1: add reversal-tracking columns to execution history table -->
    <changeSet id="0069-1-add-reversal-fields-to-si-history" author="crediblex">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="m_account_transfer_standing_instructions_history"
                              columnName="account_transfer_transaction_id"/>
            </not>
        </preConditions>
        <addColumn tableName="m_account_transfer_standing_instructions_history">
            <column name="account_transfer_transaction_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="is_reversed" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="reversed_at" type="DATETIME">
                <constraints nullable="true"/>
            </column>
            <column name="reversed_by_user_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        <addForeignKeyConstraint
                baseTableName="m_account_transfer_standing_instructions_history"
                baseColumnNames="account_transfer_transaction_id"
                constraintName="fk_si_history_account_transfer_txn"
                referencedTableName="m_account_transfer_transaction"
                referencedColumnNames="id"
                onDelete="SET NULL"/>
        <addForeignKeyConstraint
                baseTableName="m_account_transfer_standing_instructions_history"
                baseColumnNames="reversed_by_user_id"
                constraintName="fk_si_history_reversed_by_user"
                referencedTableName="m_appuser"
                referencedColumnNames="id"
                onDelete="SET NULL"/>
    </changeSet>

    <!-- ChangeSet 2: seed REVERSE permission for the new standing instruction history action -->
    <changeSet id="0069-2-add-reverse-si-history-permission" author="crediblex">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM m_permission
                WHERE entity_name = 'STANDING_INSTRUCTION_HISTORY' AND action_name = 'REVERSE'
            </sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="portfolio"/>
            <column name="code" value="REVERSE_STANDING_INSTRUCTION_HISTORY"/>
            <column name="entity_name" value="STANDING_INSTRUCTION_HISTORY"/>
            <column name="action_name" value="REVERSE"/>
            <column name="can_maker_checker" valueBoolean="true"/>
        </insert>
    </changeSet>

    <!--
        ChangeSet 3 (optional): best-effort backfill for legacy history rows that predate the schema change.
        Matches each history row to its account_transfer_transaction via account_transfer_details_id + date + amount.
        Rows that match 0 or >1 transfer transactions are left NULL and cannot be reversed via the API.
        Safe to run repeatedly (WHERE account_transfer_transaction_id IS NULL guard).
    -->
    <changeSet id="0069-3-backfill-si-history-att-id" author="crediblex" runOnChange="false">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="m_account_transfer_standing_instructions_history"
                          columnName="account_transfer_transaction_id"/>
        </preConditions>
        <sql>
            UPDATE m_account_transfer_standing_instructions_history h
            INNER JOIN (
                SELECT h2.id AS history_id, att.id AS att_id
                FROM m_account_transfer_standing_instructions_history h2
                INNER JOIN m_account_transfer_standing_instructions si
                    ON h2.standing_instruction_id = si.id
                INNER JOIN m_account_transfer_transaction att
                    ON att.account_transfer_details_id = si.account_transfer_details_id
                    AND DATE(att.transaction_date) = DATE(h2.execution_time)
                    AND att.amount = h2.amount
                    AND att.is_reversed = 0
                WHERE h2.account_transfer_transaction_id IS NULL
                  AND h2.status IN ('success', 'partial')
                GROUP BY h2.id
                HAVING COUNT(att.id) = 1
            ) match_map ON h.id = match_map.history_id
            SET h.account_transfer_transaction_id = match_map.att_id
            WHERE h.account_transfer_transaction_id IS NULL;
        </sql>
    </changeSet>

</databaseChangeLog>
