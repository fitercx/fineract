<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!--
      Bug fix (LMS-139 follow-up): m_loan_transaction_repayment_schedule_mapping had no per-installment tax column at
      all, even though m_loan_transaction itself has tracked a transaction-level tax_charges_portion_derived for a
      while. Consequences: (1) DpdMaxDaysPastDueService#outstandingAsOf under-counted historical arrears for any
      installment where a later transaction paid tax, skewing backdated DPD-strategy selection; (2) the new
      "reapply a stamped transaction's exact posted portions" replay path had no per-installment tax to reapply and
      fell back to greedily re-splitting the transaction-level tax total across installments in mapping order,
      which can land tax on a different installment than the one it was originally paid against.

      This column is nullable and defaults to null (same convention as the existing 4 portion columns), so existing
      rows are unaffected; it is only populated going forward by transactions that allocate a tax component.
    -->
    <changeSet id="0072-1-add-tax-charges-portion-derived" author="crediblex">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="m_loan_transaction_repayment_schedule_mapping" columnName="tax_charges_portion_derived"/>
            </not>
        </preConditions>
        <comment>Per-installment tax portion of a loan transaction, mirroring the existing principal/interest/fee/penalty columns</comment>
        <addColumn tableName="m_loan_transaction_repayment_schedule_mapping">
            <column name="tax_charges_portion_derived" type="decimal(19,6)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>
