<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet id="lms-176-loc-expiry-change-pending-guard" author="crediblex">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_loc_expiry_change_guard"/>
            </not>
        </preConditions>
        <comment>One committed slot per facility so a second expiry-date submit cannot also become awaiting.</comment>
        <createTable tableName="m_loc_expiry_change_guard">
            <column name="line_of_credit_id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="command_id" type="BIGINT"/>
        </createTable>
    </changeSet>
</databaseChangeLog>
