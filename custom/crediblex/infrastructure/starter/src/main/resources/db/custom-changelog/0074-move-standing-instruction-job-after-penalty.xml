<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!--
        LMS-167: standing instructions skip loans with outstanding LPI, so they must run after
        "Apply penalty to overdue loans" (01:00, finishes by 04:30 worst case, see 0046) has posted
        the day's LPI, and before "Update Loan Arrears Ageing" (05:00).
    -->
    <changeSet author="crediblex" id="lms-167-move-standing-instruction-job-after-penalty" context="postgresql,mysql">
        <comment>Run Execute Standing Instruction at 04:45, after the penalty job has applied LPI</comment>
        <update tableName="job">
            <column name="cron_expression" value="0 45 4 * * ?"/>
            <where>name='Execute Standing Instruction'</where>
        </update>
    </changeSet>

</databaseChangeLog>
