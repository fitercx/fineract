<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!--
      How far back a repayment, savings-to-loan transfer or foreclosure may be dated (read by
      BackdateWindowSettings / BackdatedRepaymentValidator). Seeded with the previously hardcoded 30-day policy, so
      behaviour is unchanged on upgrade, and editable per tenant under Admin > System > Configurations:
        enabled = true, value = N -> backdating allowed up to N days before the business date
        enabled = false           -> no day limit; backdating allowed to the start of the loan's first instalment
                                     period (never before disbursement)
      Left editable (is_trap_door = false) on purpose: widening the window is how UAT/STG settle long-lived test
      loans, and how an operator can be granted a deliberate one-off correction window without a release.
    -->
    <changeSet id="0069-1-add-backdated-transaction-max-days-config" author="crediblex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="c_configuration"/>
            <sqlCheck expectedResult="0">
                SELECT COUNT(1) FROM c_configuration WHERE name = 'backdated-transaction-max-days'
            </sqlCheck>
        </preConditions>
        <comment>Add global config for the maximum number of days a transaction may be backdated</comment>
        <insert tableName="c_configuration">
            <column name="name" value="backdated-transaction-max-days"/>
            <column name="enabled" valueBoolean="true"/>
            <column name="value" valueNumeric="30"/>
            <column name="is_trap_door" valueBoolean="false"/>
            <!-- c_configuration.description is VARCHAR(300) - keep this text within that limit. -->
            <column name="description"
                    value="Maximum days a repayment, savings-to-loan transfer or foreclosure may be backdated before the business date (never before disbursement). Disable to allow backdating to the start of the loan's first instalment period instead. Enabled without a positive value applies 30 days."/>
        </insert>
    </changeSet>
</databaseChangeLog>
