<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!--
      LMS-139 - DPD-based automatic repayment strategy switch.

      When a loan on an opted-in product goes past the DPD threshold, its stored repayment strategy is switched to
      "Principal, Interest, Penalties, Fees Order" so collections are applied to principal first. When the loan
      recovers to at or below the threshold, the original strategy is restored. The original strategy is recorded per
      loan in m_loan_dpd_strategy_switch so the revert restores exactly what the loan had before the switch.
    -->

    <changeSet id="0069-1-add-enable-dpd-strategy-switch-to-loan-product" author="crediblex">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="m_product_loan" columnName="enable_dpd_strategy_switch"/>
            </not>
        </preConditions>
        <comment>Per-product opt-in for the DPD repayment strategy auto-switch</comment>
        <addColumn tableName="m_product_loan">
            <column name="enable_dpd_strategy_switch" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="0069-2-create-loan-dpd-strategy-switch-table" author="crediblex">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_loan_dpd_strategy_switch"/>
            </not>
        </preConditions>
        <comment>Remembers each loan's pre-switch strategy so the DPD switch can be reverted exactly</comment>
        <createTable tableName="m_loan_dpd_strategy_switch">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="loan_id" type="bigint">
                <constraints nullable="false" unique="true" uniqueConstraintName="unq_loan_dpd_strategy_switch_loan"/>
            </column>
            <!-- Strategy the loan used before the most recent switch; restored verbatim on revert. -->
            <column name="original_strategy_code" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="original_strategy_name" type="varchar(200)"/>
            <column name="switched_strategy_code" type="varchar(100)"/>
            <column name="is_switched" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="max_dpd_at_switch" type="int"/>
            <column name="switched_on_date" type="date"/>
            <column name="reverted_on_date" type="date"/>
            <column name="created_on_utc" type="datetime"/>
            <column name="last_modified_on_utc" type="datetime"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="m_loan_dpd_strategy_switch"
                                 baseColumnNames="loan_id"
                                 constraintName="fk_loan_dpd_strategy_switch_loan"
                                 referencedTableName="m_loan"
                                 referencedColumnNames="id"/>

        <createIndex tableName="m_loan_dpd_strategy_switch" indexName="idx_loan_dpd_strategy_switch_is_switched">
            <column name="is_switched"/>
        </createIndex>
    </changeSet>

    <changeSet id="0069-3-add-dpd-strategy-switch-threshold-global-config" author="crediblex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="c_configuration"/>
            <sqlCheck expectedResult="0">
                SELECT COUNT(1) FROM c_configuration WHERE name = 'dpd-strategy-switch-threshold'
            </sqlCheck>
        </preConditions>
        <comment>Fleet-wide DPD threshold (days) that triggers the repayment strategy auto-switch</comment>
        <insert tableName="c_configuration">
            <column name="name" value="dpd-strategy-switch-threshold"/>
            <column name="enabled" valueBoolean="true"/>
            <column name="value" valueNumeric="60"/>
            <!-- c_configuration.description is varchar(300); keep this text within that limit. -->
            <column name="description"
                    value="Days past due above which a loan on a product with enableDpdStrategySwitch=true switches to the Principal, Interest, Penalties, Fees Order strategy, and at or below which it reverts to its original strategy. Set the day count in Number Value."/>
        </insert>
    </changeSet>
</databaseChangeLog>
