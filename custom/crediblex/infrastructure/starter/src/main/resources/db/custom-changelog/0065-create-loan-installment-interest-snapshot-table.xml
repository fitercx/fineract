<?xml version="1.0" encoding="UTF-8"?>
<!--
    CredibleX-owned table (no changes to core m_loan_repayment_schedule): stores the pre-reduction schedule
    interest_amount for an installment when an early repayment reduces it, keyed 1:1 by the installment id, so
    reprocess/undo can restore the original charged interest before replaying transactions.
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet id="0065-1-create-loan-installment-interest-snapshot-table" author="crediblex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="m_loan_repayment_schedule"/>
            <not>
                <tableExists tableName="crediblex_loan_installment_interest_snapshot"/>
            </not>
        </preConditions>
        <createTable tableName="crediblex_loan_installment_interest_snapshot">
            <column name="loan_repayment_schedule_id" type="bigint">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="interest_charged_original" type="numeric(19,6)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="crediblex_loan_installment_interest_snapshot"
                                  baseColumnNames="loan_repayment_schedule_id"
                                  constraintName="fk_credx_loan_installment_interest_snapshot"
                                  referencedTableName="m_loan_repayment_schedule"
                                  referencedColumnNames="id"
                                  onDelete="CASCADE"/>
    </changeSet>
</databaseChangeLog>
