<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- Business date of the last fully successful export; closed loans after it get one final file -->
    <changeSet author="CredibleX" id="0076-create-accrual-report-export-watermark-table">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <not>
                <tableExists tableName="cx_accrual_report_export_watermark"/>
            </not>
        </preConditions>
        <createTable tableName="cx_accrual_report_export_watermark">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="last_business_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="closed_from_exclusive" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Started by Add Periodic Accrual Transactions when it finishes; the cron is a never-firing placeholder -->
    <changeSet author="CredibleX" id="0076-add-accrual-report-s3-export-job">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM job WHERE name = 'Accrual Report S3 Export'
            </sqlCheck>
        </preConditions>
        <insert tableName="job">
            <column name="name" value="Accrual Report S3 Export"/>
            <column name="display_name" value="Accrual Report S3 Export"/>
            <column name="cron_expression" value="0 0 0 1 1 ? 2099"/>
            <column name="create_time" valueDate="now()"/>
            <column name="task_priority" valueNumeric="5"/>
            <column name="group_name"/>
            <column name="previous_run_start_time"/>
            <column name="job_key" value="Accrual Report S3 Export _ DEFAULT"/>
            <column name="initializing_errorlog"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="currently_running" valueBoolean="false"/>
            <column name="updates_allowed" valueBoolean="true"/>
            <column name="scheduler_group" valueNumeric="0"/>
            <column name="is_misfired" valueBoolean="false"/>
            <column name="node_id" valueNumeric="1"/>
            <column name="is_mismatched_job" valueBoolean="true"/>
            <column name="short_name" value="ACRS3EX"/>
        </insert>
    </changeSet>

</databaseChangeLog>
