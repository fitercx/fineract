<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!--
      LMS-139 - strategy a repayment or foreclosure was actually allocated with.

      The loan's own strategy is the one in force today. A backdated repayment or foreclosure can be allocated with a
      different strategy (the one that applied on its value date, or, for foreclosure, the strategy the quote used).
      Storing that code on the transaction lets a later replay reapply the posted portions instead of reversing the
      journals and recasting them under today's strategy. Null on rows posted before this column means "replay with
      the loan's pre-switch strategy".
    -->
    <changeSet id="0071-1-add-dpd-allocation-strategy-code" author="crediblex">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="m_loan_transaction" columnName="dpd_allocation_strategy_code"/>
            </not>
        </preConditions>
        <comment>Strategy code used to allocate this repayment or foreclosure, including backdated ones</comment>
        <addColumn tableName="m_loan_transaction">
            <column name="dpd_allocation_strategy_code" type="varchar(100)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
