<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!--
      Global switch for the "Adjusted Repayment Period" day-wise interest recalculation applied when an installment
      date is adjusted WITH interest recalculation. When enabled, the adjust flow re-prices the regenerated periods on
      actual elapsed days (outstanding * annualRate/daysInYear * actualDays), honoring each loan's own days_in_year,
      for ANY interest-calculation method. Enabled by default; can be turned off fleet-wide without any per-loan change.
    -->
    <changeSet id="0064-1-add-adjusted-repayment-period-config" author="crediblex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="c_configuration"/>
            <sqlCheck expectedResult="0">
                SELECT COUNT(1) FROM c_configuration WHERE name = 'adjust-installment-daywise-interest-recalculation'
            </sqlCheck>
        </preConditions>
        <comment>Add global config flag for Adjusted Repayment Period day-wise interest recalculation</comment>
        <insert tableName="c_configuration">
            <column name="name" value="adjust-installment-daywise-interest-recalculation"/>
            <column name="enabled" valueBoolean="true"/>
            <column name="description"
                    value="When enabled, adjusting an installment date with interest recalculation re-prices the regenerated periods day-wise (actual days x annualRate/daysInYear) for any interest calculation method."/>
        </insert>
    </changeSet>
</databaseChangeLog>
