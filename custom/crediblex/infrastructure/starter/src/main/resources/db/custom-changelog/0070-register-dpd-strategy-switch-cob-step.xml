<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!--
      LMS-139 - run the DPD repayment strategy switch once a day for every active loan.

      Ordered after the stock steps (1 APPLY_CHARGE_TO_OVERDUE_LOANS .. 6 ADD_PERIODIC_ACCRUAL_ENTRIES) so that
      everything which can still change the loan's overdue position that day has already run when DPD is measured.
    -->
    <changeSet id="0070-1-register-dpd-strategy-switch-cob-step" author="crediblex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="m_batch_business_steps"/>
            <sqlCheck expectedResult="0">
                SELECT COUNT(1) FROM m_batch_business_steps WHERE step_name = 'DPD_STRATEGY_SWITCH'
            </sqlCheck>
        </preConditions>
        <comment>Register the DPD strategy switch as the last LOAN_CLOSE_OF_BUSINESS step</comment>
        <insert tableName="m_batch_business_steps">
            <column name="job_name" value="LOAN_CLOSE_OF_BUSINESS"/>
            <column name="step_name" value="DPD_STRATEGY_SWITCH"/>
            <column name="step_order" valueNumeric="7"/>
        </insert>
    </changeSet>
</databaseChangeLog>
