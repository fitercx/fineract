<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!--
        CredibleX-owned audit trail for LOAN / LINE_OF_CREDIT "STATUS_CHANGED" webhooks. One row is written for every
        webhook attempt (see LoanStatusWebhookTrailRecorder), capturing the previous/new status (core and custom overlay),
        the entity/resource, the exact payload, when it was fired and whether it was accepted for dispatch. Gives Ops a
        queryable anchor to reconcile our status changes against what LOS received, and a foundation for future retry.

        Note: "dispatched" means publishHookEventRaw accepted the event (synchronous). Final HTTP delivery to the
        subscriber is performed asynchronously fire-and-forget by the shared WebHookProcessor; the http_status_code /
        delivered_at columns are reserved for a future enhancement that captures the delivery outcome.
    -->
    <changeSet id="0067-1-create-loan-status-webhook-trail-table" author="crediblex">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="crediblex_loan_status_webhook_trail"/>
            </not>
        </preConditions>
        <createTable tableName="crediblex_loan_status_webhook_trail">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="entity_name" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="action_name" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="resource_id" type="bigint"/>
            <column name="loan_id" type="bigint"/>
            <column name="client_id" type="bigint"/>
            <column name="office_id" type="bigint"/>
            <column name="is_drawdown" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="loc_id" type="bigint"/>
            <column name="old_core_status" type="varchar(60)"/>
            <column name="old_core_status_code" type="int"/>
            <column name="new_core_status" type="varchar(60)"/>
            <column name="new_core_status_code" type="int"/>
            <column name="old_custom_status" type="varchar(40)"/>
            <column name="new_custom_status" type="varchar(40)"/>
            <column name="trigger_source" type="varchar(40)"/>
            <column name="payload" type="clob"/>
            <column name="dispatched" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="error_message" type="varchar(1000)"/>
            <!-- Reserved for a future enhancement that captures asynchronous HTTP delivery outcome. -->
            <column name="http_status_code" type="int"/>
            <column name="delivered_at" type="datetime"/>
            <column name="fired_at" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="bigint"/>
        </createTable>

        <createIndex tableName="crediblex_loan_status_webhook_trail" indexName="idx_credx_webhook_trail_loan_id">
            <column name="loan_id"/>
        </createIndex>
        <createIndex tableName="crediblex_loan_status_webhook_trail" indexName="idx_credx_webhook_trail_entity_resource">
            <column name="entity_name"/>
            <column name="resource_id"/>
        </createIndex>
        <createIndex tableName="crediblex_loan_status_webhook_trail" indexName="idx_credx_webhook_trail_fired_at">
            <column name="fired_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
